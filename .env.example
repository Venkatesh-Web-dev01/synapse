# SYNAPSE — Environment Configuration
# Copy this file to .env and fill in your Supabase Publishable / Anon Key.
# NEVER commit production service-role keys or database passwords!

# Supabase Project URL (Verified for SYNAPSE)
SUPABASE_URL=https://hvnyyttggamtnpeernzu.supabase.co

# Supabase Project Reference: hvnyyttggamtnpeernzu

# Supabase Public Anonymous Key (Public Client / Publishable Key from Project Settings > API)
# DO NOT USE SERVICE ROLE KEY!
SUPABASE_ANON_KEY=your-public-anon-key-here

# How to run SYNAPSE with credentials:
# Option 1 (using .env file):
# flutter run -d chrome --dart-define-from-file=.env
#
# Option 2 (direct flags):
# flutter run -d chrome --dart-define=SUPABASE_ANON_KEY=your-anon-key

